# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ADMIN_EMAIL: Email for the administrator login. Defaults to team@r4v.com if unset.
ADMIN_EMAIL="team@r4v.com"

# ADMIN_PASSWORD: Password for the administrator account. If unset, bootstrap initialization will generate a secure session key.
ADMIN_PASSWORD=""

# JWT_SECRET: Secret key used to sign and verify admin session tokens.
JWT_SECRET=""
